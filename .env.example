# Fill these with `npm run setup` (asks in the terminal), or copy this file to .env.local by hand.

# GitHub — personal access token (read-only repo access is enough). `gh auth token` works.
GITHUB_TOKEN=
# Repo to track, as owner/name
GITHUB_REPO=owner/repo

# OpenAI — writes the newsletter from the activity
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Resend — sends the email
RESEND_API_KEY=
EMAIL_FROM="Newsly <onboarding@resend.dev>"
