# Fill these with `npm run setup` (asks in the terminal), or copy this file to .env.local by hand.
# On Vercel they live in Project → Settings → Environment Variables.

# Where the app runs (no trailing slash). Used for GitHub redirects and unsubscribe links.
APP_URL=http://localhost:3000

# GitHub App (login + read-only repo access). `npm run github-app` creates it and fills these in.
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OpenAI: writes and checks the letter
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Resend: sends the email
RESEND_API_KEY=
EMAIL_FROM="Newsly <onboarding@resend.dev>"

# Server secrets (setup generates them). ENCRYPTION_KEY = 64 hex chars; changing it makes saved GitHub logins unreadable.
ENCRYPTION_KEY=
CRON_SECRET=

# Storage: set automatically on Vercel when the Blob store is connected. Leave empty locally (uses data/kv/).
BLOB_READ_WRITE_TOKEN=
